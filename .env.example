# Supabase — client-safe values (publishable key ships to the browser).
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secrets. Inject these through the platform secret store; never commit real values.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
LOVABLE_DB_MIGRATION_URL="postgresql://..."
